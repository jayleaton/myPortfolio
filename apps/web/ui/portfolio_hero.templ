package ui

// The home page's hero (the hook) and the doorway tiles under it, and the
// local AI page's hero: its text replays at a published decode rate, with
// the run panel beside the stack figure (stackFigure in
// portfolio_visuals.templ).

import (
	"github.com/jayleaton/myPortfolio/apps/web/internal/apiclient"
	"github.com/jayleaton/myPortfolio/apps/web/internal/config"
)

// homeHero is the name, the hook and one line. The h1's text is the plain
// sentence (Lead + Final). The words that pass through its last slot are
// drawn by CSS from data-word, so crawlers and screen readers get only
// the sentence; the cycle needs no script and reduced motion skips it.
templ homeHero(page apiclient.PortfolioPage) {
	{{ hook := page.Portfolio.Site.Hook }}
	<section class="pf-hero pf-hero-home" data-section="hero" aria-labelledby="hero-title">
		<div class="pf-wrap pf-home-head">
			<p class="pf-kicker pf-mono"><strong>{ page.Portfolio.Name }</strong></p>
			<h1 id="hero-title" class="pf-display pf-hook" data-component="hook">
				{ hook.Lead }
				<span class="pf-hook-slot">
					for _, word := range hook.Words {
						<span class="pf-hook-pass" data-word={ word } aria-hidden="true"></span>
					}
					<span class="pf-hook-final">{ hook.Final }</span>
				</span>
			</h1>
			<p class="pf-lede pf-hook-line">{ hook.Line }</p>
		</div>
	</section>
}

// doorways are the home page's tiles, one per area and all the same
// shape: a figure, what it counts, and the names behind it. Until the X
// count is known its tile shows the handle. On a desktop with a mouse a
// tile opens downward on hover or keyboard focus to show its panel.
templ doorways(page apiclient.PortfolioPage) {
	{{ pages := page.Portfolio.Site.Pages }}
	{{ products := inArea(page.Portfolio.Featured, areaSaaS) }}
	{{ engines := inArea(page.Portfolio.Featured, areaLocalAI) }}
	{{ runs := decodeRuns(engines) }}
	{{ shipped := shippedRows(page) }}
	<section class="pf-doors" data-section="doorways" aria-label="What I build">
		<ul class="pf-wrap pf-door-list">
			<li>
				@doorway(navItem{Path: config.AppRoutes.SaaS, Page: pages.SaaS}, names(products), linkRows(shipped)) {
					<span class="pf-figure">{ itoa(len(shipped)) }</span>
					<span class="pf-door-note pf-mono">{ pages.SaaS.Teaser }</span>
				}
			</li>
			<li>
				@doorway(navItem{Path: config.AppRoutes.LocalAI, Page: pages.LocalAI}, names(engines), engineList(engineRows(engines))) {
					if len(runs) > 0 {
						<span class="pf-figure">{ runs[0].Rate }<small>{ rateUnit }</small></span>
						<span class="pf-door-note pf-mono">{ runs[0].Name } · { pages.LocalAI.Teaser }</span>
					} else {
						<span class="pf-figure">{ itoa(len(engines)) }</span>
					}
				}
			</li>
			<li>
				@doorway(navItem{Path: config.AppRoutes.Socials, Page: pages.Socials}, "@" + page.Portfolio.XHandle + " · " + page.Portfolio.Site.Sections.Videos.Title, profileList(page)) {
					<span class={ "pf-figure", templ.KV("hidden", !page.Followers.Known) } data-class:hidden="!$followersKnown">
						@odometer(page.Followers.Count, pages.Socials.Teaser)
					</span>
					<span class={ "pf-door-note pf-mono", templ.KV("hidden", !page.Followers.Known) } data-class:hidden="!$followersKnown"><span class="pf-live" aria-hidden="true"></span>{ pages.Socials.Teaser } · live</span>
					<span class={ "pf-figure", templ.KV("hidden", page.Followers.Known) } data-class:hidden="$followersKnown">{ "@" + page.Portfolio.XHandle }</span>
				}
			</li>
		</ul>
	</section>
}

// doorway is one tile. Its link holds the page's number and name, the
// figure with what it counts (children) and the names behind it, and
// covers the whole tile at rest. The panel (more) is a sibling of that
// link, so its own links are not nested in it; it ends with a link to the
// page. portfolio.css shows the panel only on a desktop with a mouse and
// keeps it out of the tab order while the tile is closed.
templ doorway(item navItem, behind string, more templ.Component) {
	<article class="pf-door" data-component="doorway">
		<a class="pf-door-link" href={ templ.SafeURL(item.Path) }>
			<span class="pf-door-top pf-mono"><span><strong>{ item.Page.Number }</strong> { item.Page.Name }</span><span class="pf-door-arrow" aria-hidden="true">→</span></span>
			<span class="pf-door-fold pf-door-fold-figure">
				<span>
					<span class="pf-door-figure">
						{ children... }
					</span>
				</span>
			</span>
			<span class="pf-door-fold pf-door-fold-text">
				<span><span class="pf-door-text">{ behind }</span></span>
			</span>
		</a>
		<div class="pf-door-more" data-component="doorway-panel">
			<div class="pf-door-more-in">
				@more
				<a class="pf-door-all pf-mono" href={ templ.SafeURL(item.Path) }>See all<span class="pf-sr">: { item.Page.Name }</span> <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</article>
}

// linkRows is a panel of one-line rows: each row is a link with its name
// and one line about it.
templ linkRows(rows []doorRow) {
	<ul class="pf-more-list">
		for _, row := range rows {
			<li>
				<a class="pf-more-row" href={ templ.SafeURL(row.URL) } target="_blank" rel="noopener">
					<span class="pf-more-name">{ row.Name }</span>
					<span class="pf-more-detail">{ row.Detail }</span>
				</a>
			</li>
		}
	</ul>
}

// engineList is the local AI panel: each project links to its card, and
// each of its headline metrics links to its receipt.
templ engineList(rows []engineRow) {
	<ul class="pf-more-list pf-more-list-tall">
		for _, row := range rows {
			<li class="pf-more-item">
				<span class="pf-more-head">
					<a class="pf-more-name" href={ templ.SafeURL(projectHref(row.Project)) }>{ row.Project.Name }</a>
					if len(row.Metrics) > 0 {
						<span class="pf-more-metrics">
							for _, metric := range row.Metrics {
								<a href={ templ.SafeURL(metric.Source) } target="_blank" rel="noopener" title={ metric.Label }>{ metricNumber(metric) }<span class="pf-sr"> { metricUnit(metric) }: { metric.Label } (receipt)</span></a>
							}
							if metricUnit(row.Metrics[0]) != "" {
								<small class="pf-mono" aria-hidden="true">{ metricUnit(row.Metrics[0]) }</small>
							}
						</span>
					}
				</span>
				<span class="pf-more-detail">{ row.Detail }</span>
			</li>
		}
	</ul>
}

// profileList is the build-in-public panel: X with the live count, YouTube
// with the latest upload, then the other profiles.
templ profileList(page apiclient.PortfolioPage) {
	{{ socials := page.Portfolio.Socials }}
	<ul class="pf-more-list pf-more-list-tall">
		if link := socialFor(socials, socialX); link.URL != "" {
			<li>
				<a class="pf-more-item" href={ templ.SafeURL(link.URL) } target="_blank" rel="noopener">
					<span class="pf-more-name">{ link.Name }</span>
					<span class={ "pf-more-detail", templ.KV("hidden", !page.Followers.Known) } data-class:hidden="!$followersKnown" data-text={ "$followers.toLocaleString('en-US') + ' " + page.Portfolio.Site.Pages.Socials.Teaser + " · live'" }>{ groupDigits(page.Followers.Count) } { page.Portfolio.Site.Pages.Socials.Teaser } · live</span>
					<span class={ "pf-more-detail", templ.KV("hidden", page.Followers.Known) } data-class:hidden="$followersKnown">{ link.Description }</span>
				</a>
			</li>
		}
		if link := socialFor(socials, socialYouTube); link.URL != "" {
			<li>
				if video, found := latestVideo(page); found {
					<a class="pf-more-item" href={ templ.SafeURL(watchURL(video)) } target="_blank" rel="noopener">
						<span class="pf-more-name">{ link.Name } <small class="pf-mono">Latest</small></span>
						<span class="pf-more-detail">{ video.Title }</span>
					</a>
				} else {
					<a class="pf-more-item" href={ templ.SafeURL(link.URL) } target="_blank" rel="noopener">
						<span class="pf-more-name">{ link.Name }</span>
						<span class="pf-more-detail">{ link.Description }</span>
					</a>
				}
			</li>
		}
		for _, row := range profileRows(socials) {
			<li>
				<a class="pf-more-item" href={ templ.SafeURL(row.URL) } target="_blank" rel="noopener">
					<span class="pf-more-name">{ row.Name }</span>
					<span class="pf-more-detail">{ row.Detail }</span>
				</a>
			</li>
		}
	</ul>
}

// localHero is the top of the local AI page: its headline and intro as
// decode tokens, the full run panel and the stack figure.
templ localHero(page apiclient.PortfolioPage, projects []apiclient.Project) {
	{{ item := page.Portfolio.Site.Pages.LocalAI }}
	{{ runs := decodeRuns(projects) }}
	<section class="pf-hero" data-section="hero" aria-labelledby="page-title">
		<div class="pf-wrap pf-hero-grid">
			<div class="pf-hero-copy" data-hero>
				<p class="pf-kicker pf-mono"><strong>{ item.Number }</strong><span>{ item.Name }</span></p>
				<h1 id="page-title" class="pf-display pf-display-page" data-decode>
					@tokenSpans(item.Heading)
				</h1>
				<p class="pf-lede" data-decode>
					@tokenSpans(item.Intro)
				</p>
				if len(runs) > 0 {
					@runPanel(runs)
				}
			</div>
			@stackFigure(page, runs)
		</div>
	</section>
}

// runPanel replays the hero text at a published decode rate. The tabs carry
// each run's data; portfolio.js runs the decode and fills the readout. With
// no script the panel still states the first run and links its receipt.
templ runPanel(runs []run) {
	<div class="pf-run" data-component="run-panel" role="group" aria-label="Replay this text at a published decode rate">
		<div class="pf-run-tabs">
			for index, item := range runs {
				<button
					class="pf-run-tab"
					type="button"
					aria-pressed={ boolAttr(index == 0) }
					data-run
					data-rate={ item.Rate }
					data-name={ item.Name }
					data-label={ item.Label }
					data-source={ item.Source }
				>
					<span class="pf-run-rate">{ item.Rate }</span>
					<span class="pf-run-name">{ item.Name }</span>
				</button>
			}
		</div>
		<dl class="pf-readout">
			<div><dt class="pf-mono">Rate</dt><dd><span data-run-rate>{ runs[0].Rate }</span> <small>{ rateUnit }</small></dd></div>
			<div><dt class="pf-mono">Tokens</dt><dd><span data-run-done>0</span><small>/<span data-run-total>0</span></small></dd></div>
			<div><dt class="pf-mono">Elapsed</dt><dd><span data-run-time>0.00</span> <small>s</small></dd></div>
		</dl>
		<div class="pf-run-foot">
			<p class="pf-run-note">
				<span data-run-label>{ runs[0].Label }</span>. This text replays at the published rate. It is not live inference.
				<a data-run-source href={ templ.SafeURL(runs[0].Source) } target="_blank" rel="noopener">Receipt&nbsp;↗</a>
			</p>
			<div class="pf-run-actions">
				<button class="pf-chip-button" type="button" data-replay>Replay</button>
				<button class="pf-chip-button" type="button" data-show-tokens aria-pressed="false">Tokens</button>
			</div>
		</div>
	</div>
}
