package ui

// The drawn parts of the "Measured" design, isolated so they can be
// replaced without touching data or sections: the stack figure (layers
// from stackLayers in portfolio.go), the bars of an evidence panel, the
// odometer and the X glyph. Everything moving is CSS; it stops under
// prefers-reduced-motion. The strict CSP forbids style="", so a bar's
// length is an SVG attribute.

import "github.com/jayleaton/myPortfolio/apps/web/internal/apiclient"

// stackFigure is "Fig. 1": the layers the featured work sits on, top
// first, over the hardware plate. Each project links to its card. The plate
// of a project with decode runs mirrors the run selected in the hero.
templ stackFigure(page apiclient.PortfolioPage, runs []run) {
	{{ hardware := page.Portfolio.Site.Hardware }}
	<figure class="pf-fig" data-component="diagram" aria-labelledby="fig-caption">
		<figcaption id="fig-caption" class="pf-fig-head pf-mono"><strong>Fig. 1</strong><span>Where I work in the stack</span></figcaption>
		<div class="pf-stack">
			<span class="pf-spine" aria-hidden="true"></span>
			<span class="pf-packets" aria-hidden="true"><span></span><span></span><span></span></span>
			<ol class="pf-plates">
				for _, plate := range stackLayers(page.Portfolio.Featured) {
					<li class="pf-plate">
						<p class="pf-plate-level pf-mono"><strong>{ levelTag(plate.Level) }</strong> { plate.Name }</p>
						for _, project := range plate.Projects {
							<a class={ "pf-plate-project", templ.KV("pf-plate-hot", len(projectRuns(project)) > 0) } href={ templ.SafeURL("#" + project.Slug) }>
								<span class="pf-plate-name">{ project.Name }</span>
								@plateValue(project)
								<span class="pf-plate-text">{ plateText(project) }</span>
							</a>
						}
					</li>
				}
				if hardware.Name != "" {
					<li class="pf-plate">
						<p class="pf-plate-level pf-mono"><strong>{ levelTag(0) }</strong> { siliconLayer }</p>
						<div class="pf-plate-project">
							<span class="pf-plate-name">{ hardware.Name }</span>
							<span class="pf-plate-value">{ hardware.Memory }<small>per unit · { hardware.Chip }</small></span>
							<span class="pf-link pf-mono">
								for index, unit := range hardware.Units {
									if index > 0 {
										<span class="pf-wire"><span>{ hardware.Link }</span><span class="pf-shuttle" aria-hidden="true"></span></span>
									}
									<span class="pf-unit">{ unit }</span>
								}
							</span>
						</div>
					</li>
				}
			</ol>
		</div>
		<p class="pf-fig-foot pf-mono">
			if len(runs) > 0 {
				<span>Packets rise at the selected rate</span>
			}
			<span>L0 → { levelTag(layerProducts) }</span>
		</p>
	</figure>
}

// plateValue is a project's headline number on its plate: the selected
// decode run when it has runs, otherwise its first published metric
// (plateText says what that one measured).
templ plateValue(project apiclient.Project) {
	if list := projectRuns(project); len(list) > 0 {
		<span class="pf-plate-value"><span data-run-rate>{ list[0].Rate }</span><small>{ rateUnit } · <span data-run-name>{ list[0].Name }</span></small></span>
	} else if len(project.Metrics) > 0 {
		<span class="pf-plate-value">{ project.Metrics[0].Value }</span>
	}
}

// metricBars draws decode rates (onOneAxis) on one axis, each with its
// conditions and receipt. Values are direct labels; the bar only compares.
templ metricBars(project apiclient.Project) {
	{{ limit := axisMax(project.Metrics) }}
	{{ _, axisUnit := splitMetric(project.Metrics[0].Value) }}
	<p class="pf-evidence-title pf-mono"><strong>Published results</strong><span>{ axisUnit }</span></p>
	<div class="pf-meters">
		for _, metric := range project.Metrics {
			{{ number, unit := splitMetric(metric.Value) }}
			<div class="pf-meter-row">
				<p class="pf-meter-top"><span class="pf-meter-name">{ subject(project, metric) }</span><span class="pf-figure">{ number }<small>{ unit }</small></span></p>
				<svg class="pf-meter" viewBox={ barBox(limit) } preserveAspectRatio="none" aria-hidden="true"><rect width={ barWidth(metric) } height={ itoa(barHeight) }></rect></svg>
				<p class="pf-meter-caption">
					<span>{ metric.Label }</span>
					@receiptLink(metric)
				</p>
			</div>
		}
	</div>
	<p class="pf-axis pf-mono" aria-hidden="true">
		for _, label := range axisLabels(limit) {
			<span>{ label }</span>
		}
	</p>
	<p class="pf-evidence-note">Conditions differ per row. These are receipts, not a ranking.</p>
}

// odometer is the live X follower count. The server renders the number;
// Datastar keeps data-target on the $followers signal and portfolio.js
// rolls one column per digit to it. Screen readers get the plain text.
templ odometer(count int, unit string) {
	<span class="pf-odo" data-odo data-attr:data-target="$followers" aria-hidden="true">{ groupDigits(count) }</span>
	<span class="pf-sr" data-text={ "$followers.toLocaleString('en-US') + ' " + unit + "'" }>{ groupDigits(count) } { unit }</span>
}

templ xGlyph() {
	<svg class="pf-x" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
}
